# ------------------------------------------------------------------
# Variáveis de ambiente do frontend
#
# 1. Copie este arquivo para .env.local (na mesma pasta) e preencha.
#    O .env.local NÃO vai para o GitHub (está no .gitignore).
# 2. Na Vercel, cadastre as mesmas variáveis em
#    Project → Settings → Environment Variables.
#
# ATENÇÃO: toda variável que começa com VITE_ é embutida no site e
# fica visível para qualquer visitante. Nunca coloque aqui senhas,
# tokens ou chaves de API secretas.
# ------------------------------------------------------------------

# Número do WhatsApp que recebe os pedidos: só dígitos, com DDI (55) e DDD.
VITE_WHATSAPP_NUMBER=5511999999999
